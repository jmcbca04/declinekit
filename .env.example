# DeclineKit, self-hosted. Copy to .env and fill in. See SELF_HOSTING.md.

# The address people use to reach your install (used in emails and card-update links).
APP_URL=https://declinekit.example.com

# Postgres. docker-compose builds DATABASE_URL from this password; set DATABASE_URL yourself
# if you bring your own database.
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgres://user:pass@host:5432/declinekit

# 32-byte key that encrypts stored Stripe keys and webhook secrets. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Protects the scheduled jobs (/api/cron/*). Any long random string: openssl rand -hex 24
CRON_SECRET=

# Email. Sign-in codes and recovery emails go out through any SMTP server
# (Amazon SES, Postmark, Mailgun, Resend, Fastmail...).
SMTP_URL=smtp://user:password@smtp.example.com:587
# Emails are sent from <role>@MAIL_DOMAIN: billing@, login@, alerts@. The domain must be
# authorized (SPF/DKIM) with your SMTP provider.
MAIL_DOMAIN=mail.example.com

# Optional: where to send alerts about signups, connections and recoveries.
# FOUNDER_EMAIL=you@example.com

# Optional: accept Stripe test-mode keys (rk_test_...) for trying DeclineKit out.
# ALLOW_TEST_KEYS=true
